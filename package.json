{
  "name": "anixops-codedrivenmedia",
  "version": "1.0.0",
  "description": "Code-driven video production framework using React and Remotion",
  "main": "src/index.tsx",
  "scripts": {
    "dev": "remotion studio src/index.tsx --port=3000",
    "dev:fast": "remotion studio src/index.tsx --port=3000 --webpack-poll",
    "preview": "remotion preview src/index.tsx --port=3001",
    "build:remotion": "remotion render src/index.tsx",
    "render": "remotion render",
    "render:prod": "remotion render --codec=h264 --crf=18 --scale=1",
    "render:preview": "remotion render --codec=h264 --crf=28 --scale=0.5",
    "upgrade": "remotion upgrade",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css,md}\"",
    "clean": "rimraf dist out",
    "prepare": "husky install",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "video-gen": "node scripts/video-gen.js",
    "video-init": "node scripts/video-gen.js init",
    "video-validate": "node scripts/video-gen.js validate",
    "video-render": "node scripts/video-gen.js all",
    "batch-render": "node scripts/batch-render.js",
    "validate-config": "node scripts/validate-config.js",
    "demo": "node scripts/demo.js",
    "assets": "node scripts/assets/manager.js",
    "assets:check": "node scripts/assets/check.js",
    "assets:validate": "node scripts/assets/validate.js",
    "assets:optimize": "node scripts/assets/optimize.js",
    "assets:backup": "node scripts/assets/backup.js create",
    "assets:restore": "node scripts/assets/backup.js restore",
    "assets:list-backups": "node scripts/assets/backup.js list",
    "assets:cleanup": "node scripts/assets/backup.js cleanup",
    "assets:init": "node scripts/assets/manager.js init",
    "assets:status": "node scripts/assets/manager.js status",
    "assets:full-check": "node scripts/assets/manager.js full-check",
    "build": "node scripts/build.js full",
    "build:quick": "node scripts/build.js quick",
    "build:dev": "node scripts/build.js dev",
    "build:code": "node scripts/code-driven-build.js"
  },
  "keywords": [
    "video",
    "animation",
    "react",
    "remotion",
    "gsap",
    "code-driven",
    "motion-graphics",
    "typescript"
  ],
  "author": {
    "name": "AnixOps Team",
    "email": "team@anixops.com",
    "url": "https://anixops.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/AnixOps/AnixOps-CodeDrivenMedia.git"
  },
  "bugs": {
    "url": "https://github.com/AnixOps/AnixOps-CodeDrivenMedia/issues"
  },
  "homepage": "https://github.com/AnixOps/AnixOps-CodeDrivenMedia#readme",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "dependencies": {
    "@remotion/cli": "4.0.354",
    "clsx": "^2.0.0",
    "framer-motion": "^10.16.0",
    "gsap": "^3.12.2",
    "lodash-es": "^4.17.21",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "remotion": "4.0.354",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.38.0",
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^14.4.3",
    "@types/lodash-es": "^4.17.8",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.28.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "husky": "^8.0.3",
    "jest": "^29.6.0",
    "jest-environment-jsdom": "^29.6.0",
    "lint-staged": "^13.2.3",
    "prettier": "^3.0.0",
    "rimraf": "^5.0.1",
    "ts-jest": "^29.1.0",
    "typescript": "^5.1.0",
    "vitepress": "^1.0.0-rc.4"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "src/**/*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "jsdom",
    "setupFilesAfterEnv": [
      "<rootDir>/src/setupTests.ts"
    ],
    "moduleNameMapping": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "collectCoverageFrom": [
      "src/**/*.{ts,tsx}",
      "!src/**/*.d.ts",
      "!src/index.ts"
    ],
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    }
  },
  "remotion": {
    "entryPoint": "./src/index.ts",
    "publicDir": "./public"
  }
}